# Copy to .env.local. Values are added as each backlog task needs them.

# Project email (backlog task 7). See docs/inbound-email.md.
INBOUND_EMAIL_DOMAIN=in.plenum.example
SES_INBOUND_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:plenum-inbound
AWS_REGION=eu-west-1

# Database (backlog task 2). Project: Plenum, EU West (Ireland). See docs/database.md.
SUPABASE_URL=https://uwimagjkbwourvepvtns.supabase.co
# Secret. Server only. Copy from the Supabase dashboard (Project Settings, API Keys); never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Public. Safe in the browser; access is limited by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://uwimagjkbwourvepvtns.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI triage (backlog task 10). Use an EU Bedrock model or inference profile id, e.g. eu.anthropic.claude-...
BEDROCK_MODEL_ID=
BEDROCK_REGION=eu-west-1

# Sign-in (stage 3). "supabase" = email link; "entra" is reserved for task 3.
AUTH_PROVIDER=supabase

# Email sending (stage 3, S3-4). "fake" writes to the outbox table; nothing is delivered.
EMAIL_PROVIDER=fake
