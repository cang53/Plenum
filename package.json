{
  "name": "plenum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ai:eval": "vitest run --config vitest.eval.config.ts",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "playwright test",
    "seed": "node --env-file=.env.local scripts/seed-local.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:switches": "node --env-file-if-exists=.env.local scripts/check-switches.mjs",
    "pilot:dry-run": "node --env-file=.env.local scripts/pilot-dry-run.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1155.0",
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "mailparser": "^3.12.2",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
